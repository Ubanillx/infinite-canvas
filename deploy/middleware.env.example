# 本地开发中间件（docker-compose.middleware.yml）的可选覆盖值。
# 不创建该文件时使用 compose 内置默认值，即可直接启动开发环境。
# 端口默认避开 5432/9000，避免与本机其它项目冲突。
POSTGRES_PORT=5433
POSTGRES_DB=infinite_canvas
POSTGRES_USER=infinite
POSTGRES_PASSWORD=infinite_canvas_dev
RUSTFS_PORT=9010
RUSTFS_CONSOLE_PORT=9011
S3_REGION=us-east-1
S3_BUCKET=infinite-canvas
S3_ACCESS_KEY=infinite
S3_SECRET_KEY=infinite_canvas_dev
