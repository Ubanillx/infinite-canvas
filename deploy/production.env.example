# Copy to DEPLOY_DIR/shared/production.env on the deployment host (chmod 600).
# Never put server API keys or SSH credentials here or in the repository.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
INFINITE_CANVAS_ALLOWED_HOSTS=localhost,canvas.example.com
INFINITE_CANVAS_ALLOWED_NETWORKS=127.0.0.1,::1,192.168.0.0/22,172.16.0.0/12
# 以逗号分隔的用户名始终保留管理员权限，便于统一登录或应急恢复。
# 未设置时，最早注册的用户会自动成为管理员；之后可在配置页的「用户与工作区」中授予或撤销。
# INFINITE_CANVAS_ADMIN_USERNAMES=admin,ops
ANALYTICS_GA4_ID=
ANALYTICS_BAIDU_ID=
# Keycloak 统一登录（可选）。三项必填配置齐全后才启用，并默认关闭本地登录。
# Keycloak 客户端使用标准授权码流程；回调地址需登记为：
#   https://canvas.example.com/api/auth/keycloak/callback
# 退出登录回跳地址需登记为：
#   https://canvas.example.com/
# 如果反向代理没有传递 X-Forwarded-Proto/Host，请显式设置两个 URI。
# KEYCLOAK_URL=https://sso.example.com
# KEYCLOAK_REALM=infinite-canvas
# KEYCLOAK_CLIENT_ID=infinite-canvas
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_REDIRECT_URI=https://canvas.example.com/api/auth/keycloak/callback
# KEYCLOAK_POST_LOGOUT_REDIRECT_URI=https://canvas.example.com/
# KEYCLOAK_SCOPES=profile email
# 仅本地 HTTP 测试的 Keycloak 才设为 true。
# KEYCLOAK_ALLOW_INSECURE=false
# 启用 Keycloak 后默认关闭本地注册和登录；显式设为 true 可保留管理员应急入口。
# KEYCLOAK_ALLOW_LOCAL_LOGIN=false
# 新部署尚无管理员时可用 SMTP 环境变量完成首次邮箱验证注册。
# 后续在「系统配置 → 注册与邮箱」保存的数据库配置优先于这些初始值。
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_FROM_NAME=无限画布
# Database and object storage. Compose 默认连内置 postgres/rustfs 服务；
# 使用外部实例时改为对应地址，并务必替换默认密码与密钥。
DATABASE_URL=postgres://infinite:CHANGE_ME@postgres:5432/infinite_canvas
POSTGRES_DB=infinite_canvas
POSTGRES_USER=infinite
POSTGRES_PASSWORD=CHANGE_ME
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=infinite-canvas
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
